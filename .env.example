# Copy to deploy/.env on the server and fill in.  NEVER commit the real .env.

APP_ENV=production
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# your public address
SITE_URL=https://moasses.eu
DOMAIN=moasses.eu
# email for Let's Encrypt certificate notices
ACME_EMAIL=armin.moasses@gmail.com
# private, hard-to-guess admin address (letters, digits, - _)
ADMIN_PATH=/manage-change-me-7f3k
# optional: only these IPs/networks may even see the admin panel (comma separated)
# ADMIN_ALLOWED_IPS=203.0.113.7,2001:db8::/48
ADMIN_IDLE_MINUTES=30
# number of reverse proxies in front of the app (Caddy = 1)
TRUST_PROXY=1
